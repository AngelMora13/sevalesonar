---
import { SITE_INFO } from '../lib/constants';
import IconBase from './IconBase.astro';
---

<section id="contacto" class="py-16 md:py-24 bg-gradient-to-b from-[#fffbf7] via-[#fbf1e8] to-[#f7e4d5] border-t border-[#f0ded2]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-[#b8561d] bg-[#faefe5] px-4 py-1.5 rounded-full border border-[#eed4c2]">
        Estamos a tu orden
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-[#2b1e1a] mt-4 mb-4">
        Haz tu pedido o consulta disponibilidad
      </h2>
      <p class="text-[#695244] text-base leading-relaxed">
        Cada uno de nuestros ponquesitos y postres es elaborado de manera artesanal con ingredientes de primera calidad para garantizar una experiencia inolvidable.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Card 1: Horarios -->
      <div class="glass-card rounded-3xl p-8 border border-[#f0ded2] shadow-sm flex flex-col justify-between">
        <div>
          <div class="w-14 h-14 rounded-2xl bg-amber-100 flex items-center justify-center text-3xl mb-6 text-[#b8561d]">
            <IconBase name="clock" fontSize="1.85rem" />
          </div>
          <h3 class="text-xl font-bold font-display text-[#2b1e1a] mb-3">
            Horarios de Atención
          </h3>
          <p class="text-sm text-[#695244] mb-4">
            Recibimos y coordinamos tus encargos en los siguientes horarios:
          </p>
          <div class="space-y-2 text-sm text-[#4a3b32]">
            <div class="flex justify-between py-1.5 border-b border-[#f0ded2]">
              <span class="font-medium">Semana:</span>
              <span class="font-bold text-[#b8561d] text-right">{SITE_INFO.scheduleWeekdays}</span>
            </div>
            <div class="flex justify-between py-1.5">
              <span class="font-medium">Fin de Semana:</span>
              <span class="font-bold text-[#b8561d] text-right">{SITE_INFO.scheduleWeekend}</span>
            </div>
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-[#f0ded2] text-xs text-[#826a5d] inline-flex items-center gap-1.5">
          <IconBase name="sparkles" fontSize="1.1em" />
          <span>{SITE_INFO.specialNotice}</span>
        </div>
      </div>

      <!-- Card 2: Contacto Directo y WhatsApp -->
      <div class="glass-card rounded-3xl p-8 border-2 border-emerald-500/30 bg-emerald-50/40 shadow-sm flex flex-col justify-between relative overflow-hidden">
        <div class="absolute -right-8 -top-8 w-28 h-28 bg-emerald-200/40 rounded-full blur-2xl"></div>
        <div>
          <div class="w-14 h-14 rounded-2xl bg-emerald-100 flex items-center justify-center text-3xl mb-6 text-emerald-700">
            <IconBase name="chat" fontSize="1.85rem" />
          </div>
          <h3 class="text-xl font-bold font-display text-[#2b1e1a] mb-3">
            WhatsApp Oficial
          </h3>
          <p class="text-sm text-[#695244] mb-4">
            Canal directo y prioritario para pedidos, cotizaciones y atención personalizada:
          </p>
          <div class="p-3 bg-white/80 rounded-xl border border-emerald-200/70 mb-4 text-center">
            <span class="text-base font-bold text-emerald-800">
              {SITE_INFO.whatsappFormatted}
            </span>
          </div>
        </div>
        <a
          href={`https://wa.me/${SITE_INFO.whatsappNumber}?text=${encodeURIComponent(SITE_INFO.whatsappDefaultMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 py-3 px-5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm shadow-md transition-all active:scale-[0.98]"
        >
          <span>Abrir Conversación</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Card 3: Entregas y Redes Sociales -->
      <div class="glass-card rounded-3xl p-8 border border-[#f0ded2] shadow-sm flex flex-col justify-between">
        <div>
          <div class="w-14 h-14 rounded-2xl bg-rose-100 flex items-center justify-center text-3xl mb-6 text-rose-700">
            <IconBase name="delivery" fontSize="1.85rem" />
          </div>
          <h3 class="text-xl font-bold font-display text-[#2b1e1a] mb-3">
            Entregas & Redes
          </h3>
          <div class="space-y-3 text-sm text-[#695244]">
            <p>
              <strong class="text-[#2b1e1a]">Ubicación:</strong> {SITE_INFO.location}
            </p>
            <p>
              <strong class="text-[#2b1e1a]">Modalidad:</strong> {SITE_INFO.pickupNote}
            </p>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-[#f0ded2]">
          <a
            href={SITE_INFO.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-semibold text-rose-600 hover:text-rose-700 transition-colors"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>{SITE_INFO.instagram}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
