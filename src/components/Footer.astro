---
import { CONTACT_INFO } from '../lib/constants';
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#241713] text-[#f5ebe1] py-12 border-t border-[#3b2822]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Col 1: Brand -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-rose-500 flex items-center justify-center text-xl">
            🧁
          </div>
          <span class="text-2xl font-bold font-display tracking-tight text-white">
            Se Vale Soñar
          </span>
        </div>
        <p class="text-sm text-[#b89e90] max-w-sm">
          {CONTACT_INFO.tagline}. Elaboramos momentos dulces con la calidez y el sabor de la repostería artesanal.
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-[#d97736] mb-4">Menú</h4>
        <ul class="space-y-2 text-sm text-[#b89e90]">
          <li><a href="#catalogo" class="hover:text-white transition-colors">🧁 Ponquesitos</a></li>
          <li><a href="#catalogo" class="hover:text-white transition-colors">🍰 Otros Postres</a></li>
          <li><a href="#contacto" class="hover:text-white transition-colors">📍 Horarios y Entregas</a></li>
        </ul>
      </div>

      <!-- Col 3: Admin & Contact -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-[#d97736] mb-4">Gestión</h4>
        <ul class="space-y-2 text-sm text-[#b89e90]">
          <li>
            <a href="/admin" class="hover:text-white transition-colors flex items-center gap-1.5">
              <span>🔐 Panel de Administración</span>
            </a>
          </li>
          <li>
            <a
              href={`https://wa.me/${CONTACT_INFO.whatsappNumber}`}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-emerald-400 transition-colors"
            >
              WhatsApp: {CONTACT_INFO.whatsappFormatted}
            </a>
          </li>
          <li>
            <a
              href={CONTACT_INFO.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-rose-400 transition-colors"
            >
              Instagram: {CONTACT_INFO.instagram}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-[#3b2822] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#8f7568]">
      <p>© {currentYear} Se Vale Soñar. Todos los derechos reservados.</p>
      <p>Desplegado en Cloudflare con Astro + Vue + D1 + R2</p>
    </div>
  </div>
</footer>
