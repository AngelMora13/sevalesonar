---
import { SITE_INFO } from '../lib/constants';
import IconBase from './IconBase.astro';

interface Props {
  hideNavLinks?: boolean;
}

const { hideNavLinks = false } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#241713] text-[#f5ebe1] py-12 border-t border-[#3b2822]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class={`grid grid-cols-1 ${hideNavLinks ? 'md:grid-cols-3' : 'md:grid-cols-4'} gap-8 mb-10`}>
      <!-- Col 1: Brand -->
      <div class={`${hideNavLinks ? 'md:col-span-2' : 'md:col-span-2'} space-y-4`}>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-rose-500 flex items-center justify-center text-xl">
            <IconBase name="cupcake" fontSize="1.35rem" />
          </div>
          <span class="text-2xl font-bold font-display tracking-tight text-white">
            {SITE_INFO.storeName}
          </span>
        </div>
        <p class="text-sm text-[#b89e90] max-w-sm">
          {SITE_INFO.tagline}. Elaboramos momentos dulces con la calidez y el sabor de la repostería artesanal.
        </p>
      </div>

      <!-- Col 2: Navigation (Hidden when hideNavLinks is true) -->
      {
        !hideNavLinks && (
          <div>
            <h4 class="text-xs font-bold uppercase tracking-widest text-[#d97736] mb-4">Menú</h4>
            <ul class="space-y-2 text-sm text-[#b89e90]">
              <li>
                <a href="#catalogo" class="hover:text-white transition-colors inline-flex items-center gap-1.5">
                  <IconBase name="cupcake" fontSize="1em" />
                  <span>Ponquesitos</span>
                </a>
              </li>
              <li>
                <a href="#catalogo" class="hover:text-white transition-colors inline-flex items-center gap-1.5">
                  <IconBase name="cake" fontSize="1em" />
                  <span>Otros Postres</span>
                </a>
              </li>
              <li>
                <a href="#contacto" class="hover:text-white transition-colors inline-flex items-center gap-1.5">
                  <IconBase name="pin" fontSize="1em" />
                  <span>Horarios y Entregas</span>
                </a>
              </li>
            </ul>
          </div>
        )
      }

      <!-- Col 3: Contact Channels -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-[#d97736] mb-4">Atención al Cliente</h4>
        <ul class="space-y-2.5 text-sm text-[#b89e90]">
          <li>
            <a
              href={`https://wa.me/${SITE_INFO.whatsappNumber}?text=${encodeURIComponent(SITE_INFO.whatsappDefaultMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-emerald-400 transition-colors inline-flex items-center gap-1.5"
            >
              <IconBase name="chat" fontSize="1em" />
              <span>WhatsApp: {SITE_INFO.whatsappFormatted}</span>
            </a>
          </li>
          <li>
            <a
              href={SITE_INFO.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-rose-400 transition-colors inline-flex items-center gap-1.5"
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>Instagram: {SITE_INFO.instagram}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-[#3b2822] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#8f7568]">
      <p>© {currentYear} {SITE_INFO.storeName}. Todos los derechos reservados.</p>
      <p>Hecho con amor y dedicación en {SITE_INFO.location}.</p>
    </div>
  </div>
</footer>
