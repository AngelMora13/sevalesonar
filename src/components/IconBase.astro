---
import {
  emojiSvgMap,
  emojiImageMap,
  emojiFallback,
  type EmojiName,
} from "../types/icons";

export interface Props {
  name: EmojiName;
  fontSize?: string | number;
  width?: string | number;
  height?: string | number;
  class?: string;
  color?: string;
  rounded?: boolean;
}

const {
  name,
  fontSize = "1em",
  width,
  height,
  class: className = "",
  color = "currentColor",
  rounded = false,
} = Astro.props;

const formatDim = (val?: string | number) => {
  if (val === undefined || val === null) return "1em";
  return typeof val === "number" ? `${val}px` : val;
};

const baseSize = formatDim(fontSize);
const w = width ? formatDim(width) : baseSize;
const h = height ? formatDim(height) : baseSize;

const svgContent = emojiSvgMap[name]?.trim() || "";
const imageSrc = emojiImageMap[name] || "";
const fallbackChar = emojiFallback[name] || "✨";
---

<span
  class={`inline-flex items-center justify-center shrink-0 align-middle select-none icon-base ${className}`}
  style={`width: ${w}; height: ${h}; font-size: ${baseSize}; color: ${color};`}
  title={name}
  aria-hidden="true"
>
  {
    svgContent ? (
      <span
        class="inline-flex items-center justify-center w-full h-full [&>svg]:w-full [&>svg]:h-full"
        set:html={svgContent}
      />
    ) : imageSrc ? (
      <img
        src={imageSrc}
        alt={name}
        class={`w-full h-full object-contain pointer-events-none select-none ${rounded ? "rounded-full" : ""}`}
        loading="lazy"
        style="transform: scale(1.1);"
      />
    ) : (
      <span class="leading-none text-center">{fallbackChar}</span>
    )
  }
</span>
