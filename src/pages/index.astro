---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Catalog from '../components/Catalog.vue';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import { getDb, schema } from '../db/client';
import { SITE_INFO } from '../lib/constants';
import { eq, desc } from 'drizzle-orm';

export const prerender = false;

let initialProducts: any[] = [];
try {
  const db = await getDb();
  initialProducts = await db
    .select()
    .from(schema.products)
    .where(eq(schema.products.active, true))
    .orderBy(schema.products.order_index, desc(schema.products.created_at));
} catch (e) {
  console.error('Error loading products on index.astro:', e);
}

const featuredProduct = initialProducts.find(p => p.is_featured) || null;
---

<Layout
  title={SITE_INFO.title}
  description={SITE_INFO.description}
  canonical={SITE_INFO.siteUrl}
>
  <Navbar />
  <main>
    <Hero featuredProduct={featuredProduct} />
    <Catalog client:load initialProducts={initialProducts} whatsappNumber={SITE_INFO.whatsappNumber} />
    <ContactSection />
  </main>
  <Footer />
</Layout>
